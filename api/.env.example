# Angel's Floor CMS — Configuration Production
# Copier ce fichier en .env et modifier les valeurs

# Clé secrète JWT (générer une chaîne aléatoire longue)
CMS_JWT_SECRET=your-random-secret-key-here-at-least-32-chars

# Identifiants admin
CMS_ADMIN_EMAIL=admin@angelsfloor.bj
# Générer avec : php -r "echo password_hash('votre-mot-de-passe', PASSWORD_DEFAULT);"
CMS_ADMIN_PASSWORD_HASH=

# CORS — domaines autorisés (séparés par des virgules)
# En production, remplacer par le domaine réel
CMS_ALLOWED_ORIGINS=https://angelsfloor.com,https://www.angelsfloor.com
